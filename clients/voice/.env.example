# Copie ce fichier en .env sur l'appareil, puis remplis-le. Ne le commite jamais.

# Adresse du cerveau. En local : ws://127.0.0.1:8765/ws
# Via Tailscale (recommandé pour la voiture) : ws://jarvis-pc.ton-tailnet.ts.net:8765/ws
JARVIS_SERVER=ws://127.0.0.1:8765/ws

# Token de CET appareil : python -m jarvis_brain token add <nom> (sur le serveur)
JARVIS_TOKEN=

# Réveil : local (openWakeWord, « Hey Jarvis ») | server (« Jarvis, … ») | key (touche Entrée)
JARVIS_WAKE=local
JARVIS_WAKE_MODEL=hey_jarvis
JARVIS_WAKE_THRESHOLD=0.5

# Micro et sortie son (numéro ou nom). Vide = périphérique par défaut.
# Liste : python -m jarvis_client --list-devices
JARVIS_INPUT_DEVICE=
JARVIS_OUTPUT_DEVICE=
