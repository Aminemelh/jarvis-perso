# Copie ce fichier en .env (dans le dossier brain/) puis remplis-le.
# Le .env est ignoré par Git : tes secrets n'iront jamais sur GitHub.

# --- Réseau ---
# 127.0.0.1 = accessible seulement depuis ce PC (le plus sûr).
# Pour les autres appareils, garde 127.0.0.1 et passe par « tailscale serve » (docs/SECURITY.md).
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
# HTTPS direct (facultatif si tu utilises Tailscale) :
# JARVIS_TLS_CERT=certs/jarvis.pem
# JARVIS_TLS_KEY=certs/jarvis-key.pem

# --- Cerveau (Claude) ---
# Clé sur https://platform.claude.com -> API Keys. Payée à l'usage.
ANTHROPIC_API_KEY=
# claude | echo (echo = mode test gratuit, sans IA)
JARVIS_LLM=claude
JARVIS_CLAUDE_MODEL=claude-opus-5-5
# low | medium | high : plus haut = plus réfléchi mais plus lent et plus cher.
JARVIS_CLAUDE_EFFORT=low
JARVIS_CLAUDE_MAX_TOKENS=2048
# Relance automatique sur un autre modèle si une demande est refusée à tort.
JARVIS_CLAUDE_FALLBACKS=true
# Nombre d'échanges gardés en mémoire courte (partagée entre appareils)
JARVIS_HISTORY_TURNS=20

# --- Personnalité ---
JARVIS_NAME=Jarvis
JARVIS_USER_TITLE=Monsieur
JARVIS_LANGUAGE=fr
JARVIS_TIMEZONE=America/Toronto

# --- Reconnaissance vocale (locale, gratuite) ---
# whisper | none
JARVIS_STT=whisper
# tiny | base | small | medium | large-v3 : plus gros = plus précis, plus lent
JARVIS_WHISPER_MODEL=small
# cpu | cuda (carte NVIDIA)
JARVIS_WHISPER_DEVICE=cpu
# int8 (CPU) | float16 (GPU)
JARVIS_WHISPER_COMPUTE=int8

# --- Voix (locale, gratuite) ---
# piper | none
JARVIS_TTS=piper
JARVIS_PIPER_VOICE=models/piper/fr_FR-tom-medium.onnx
# 1.0 = normal, 1.1 = un peu plus posé
JARVIS_PIPER_LENGTH_SCALE=1.0

# --- Localisation (météo, recherche web) ---
JARVIS_CITY=Montréal
JARVIS_REGION=Québec
JARVIS_COUNTRY=CA

# --- Outils ---
JARVIS_TOOLS=true
# Recherche web par Claude (facturée environ 1 cent par recherche)
JARVIS_WEB_SEARCH=true

# --- Actualités (flux RSS/Atom, gratuits) ---
# Vide = Radio-Canada, Le Devoir, La Presse. Format : Nom|adresse, Nom|adresse
# JARVIS_NEWS_FEEDS=Radio-Canada|https://ici.radio-canada.ca/rss/4159,Le Devoir|https://www.ledevoir.com/rss/manchettes.xml

# --- Contrôle du PC (Windows) ---
# Actif par défaut sous Windows : ouvrir des applis de la liste, son, musique, verrouiller, veille, arrêt.
JARVIS_PC_CONTROL=true
# Applis en plus de la liste par défaut (navigateur, spotify, explorateur, calculatrice, bloc-notes,
# paramètres, discord, steam, vs code, outlook…). Format : nom=commande;nom=commande
# JARVIS_PC_APPS=obs=obs64.exe;notion=notion:

# --- Courriels (IMAP, lecture seule) : un bloc par compte, <NOM> au choix ---
# Gmail : mot de passe d'application obligatoire (voir docs/CONNECTIONS.md)
# JARVIS_MAIL_GMAIL_HOST=imap.gmail.com
# JARVIS_MAIL_GMAIL_USER=toi@gmail.com
# JARVIS_MAIL_GMAIL_PASSWORD=abcd efgh ijkl mnop
# Second compte, par exemple l'UQAM ou iCloud :
# JARVIS_MAIL_ICLOUD_HOST=imap.mail.me.com
# JARVIS_MAIL_ICLOUD_USER=toi@icloud.com
# JARVIS_MAIL_ICLOUD_PASSWORD=

# --- Agendas : adresse iCal SECRÈTE, un par ligne, <NOM> au choix ---
# JARVIS_CALENDAR_PERSO_URL=https://calendar.google.com/calendar/ical/.../private-.../basic.ics
# JARVIS_CALENDAR_COURS_URL=
# Moodle UQAM (remises, quiz, examens) : voir docs/CONNECTIONS.md
# JARVIS_CALENDAR_MOODLE_URL=https://moodle.uqam.ca/calendar/export_execute.php?userid=…&authtoken=…
# Agendas d'école (vide = détection automatique : moodle, uqam, cours…)
# JARVIS_SCHOOL_CALENDARS=moodle,cours
# Rappel N jours avant une remise (puis la veille et le matin du jour J)
JARVIS_DEADLINE_REMINDER_DAYS=3

# --- Surveillance en arrière-plan ---
# Vérification des courriels et de l'agenda toutes les N secondes
JARVIS_WATCH_INTERVAL=120
# Rappel N minutes avant un rendez-vous
JARVIS_REMINDER_MINUTES=30
# Heures où Jarvis affiche sans parler (« off » pour désactiver)
JARVIS_QUIET_HOURS=22-7
# Briefing du matin (« off » pour désactiver). Donné une fois, entre cette heure et midi.
JARVIS_BRIEFING_TIME=07:30
# Rappel N jours avant l'échéance d'une facture suivie (puis la veille, le jour J, et en cas de retard)
JARVIS_BILL_REMINDER_DAYS=3

# --- Comptes connectés par OAuth (voir docs/CONNECTIONS.md) ---
# Spotify : identifiant de ton application (developer.spotify.com), puis : python -m jarvis_brain connect spotify
JARVIS_SPOTIFY_CLIENT_ID=
# Google Agenda (ajout d'événements) : client OAuth « Application de bureau », puis : python -m jarvis_brain connect google
JARVIS_GOOGLE_CLIENT_ID=
JARVIS_GOOGLE_CLIENT_SECRET=

# --- Sécurité ---
# Appareils qui voient le tableau de bord sécurité et peuvent révoquer les autres
JARVIS_ADMIN_DEVICES=pc
# Vérification des fuites de données de tes adresses (facultatif, clé payante : haveibeenpwned.com/API/Key)
JARVIS_HIBP_API_KEY=

# --- Limites ---
JARVIS_MAX_AUDIO_SECONDS=30
JARVIS_MAX_TEXT_CHARS=2000
