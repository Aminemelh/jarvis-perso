# Copie ce fichier en .env (dans le dossier brain/) puis remplis-le.
# Le .env est ignoré par Git : tes secrets n'iront jamais sur GitHub.

# --- Réseau ---
# 127.0.0.1 = accessible seulement depuis ce PC (le plus sûr).
# Pour les autres appareils, garde 127.0.0.1 et passe par « tailscale serve » (docs/SECURITY.md).
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
# HTTPS direct (facultatif si tu utilises Tailscale) :
# JARVIS_TLS_CERT=certs/jarvis.pem
# JARVIS_TLS_KEY=certs/jarvis-key.pem

# --- Cerveau (Claude) ---
# Clé sur https://platform.claude.com -> API Keys. Payée à l'usage.
ANTHROPIC_API_KEY=
# claude | echo (echo = mode test gratuit, sans IA)
JARVIS_LLM=claude
JARVIS_CLAUDE_MODEL=claude-opus-5-5
# low | medium | high : plus haut = plus réfléchi mais plus lent et plus cher.
JARVIS_CLAUDE_EFFORT=low
JARVIS_CLAUDE_MAX_TOKENS=2048
# Relance automatique sur un autre modèle si une demande est refusée à tort.
JARVIS_CLAUDE_FALLBACKS=true
# Nombre d'échanges gardés en mémoire courte (partagée entre appareils)
JARVIS_HISTORY_TURNS=20

# --- Personnalité ---
JARVIS_NAME=Jarvis
JARVIS_USER_TITLE=Monsieur
JARVIS_LANGUAGE=fr
JARVIS_TIMEZONE=America/Toronto

# --- Reconnaissance vocale (locale, gratuite) ---
# whisper | none
JARVIS_STT=whisper
# tiny | base | small | medium | large-v3 : plus gros = plus précis, plus lent
JARVIS_WHISPER_MODEL=small
# cpu | cuda (carte NVIDIA)
JARVIS_WHISPER_DEVICE=cpu
# int8 (CPU) | float16 (GPU)
JARVIS_WHISPER_COMPUTE=int8

# --- Voix (locale, gratuite) ---
# piper | none
JARVIS_TTS=piper
JARVIS_PIPER_VOICE=models/piper/fr_FR-tom-medium.onnx
# 1.0 = normal, 1.1 = un peu plus posé
JARVIS_PIPER_LENGTH_SCALE=1.0

# --- Limites ---
JARVIS_MAX_AUDIO_SECONDS=30
JARVIS_MAX_TEXT_CHARS=2000
